# ---- Passwords --------------------------------------------------------------
# Printed on the invitations. Once you set a guest password from the admin
# Settings page it is stored (hashed) in the database and takes over from this.
SITE_PASSWORD=change-me

# Only the hosts should know this one. It is the ONLY thing protecting the
# guest list, so make it long and random — not a word. This one stays an
# environment variable on purpose, so a bad save can't lock you out.
ADMIN_PASSWORD=change-me-too

# Signs the login cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ---- Convex -----------------------------------------------------------------
# The deployment URL from `npx convex dev` (https://<name>.convex.cloud).
CONVEX_URL=

# Shared secret between Next.js and Convex, so the database only answers to
# your server. Generate with: openssl rand -hex 32
# Must ALSO be set on Convex: npx convex env set ADMIN_API_KEY <same value>
ADMIN_API_KEY=
