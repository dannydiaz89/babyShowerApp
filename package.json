{
  "name": "baby-shower-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "convex": "convex dev",
    "dev:all": "pnpm run --parallel --reporter append-only dev convex",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "dev:scratch": "NEXT_DIST_DIR=.next-scratch next dev --port 3099",
    "seed": "node scripts/seed.mjs",
    "seed:clear": "node scripts/seed.mjs --clear"
  },
  "dependencies": {
    "convex": "^1.17.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
